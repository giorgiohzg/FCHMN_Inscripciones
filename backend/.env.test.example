# Variables para las PRUEBAS DE INTEGRACIÓN. Copiar a `.env.test`.
#
# La base debe ser la de `docker-compose.test.yml` (puerto 55432, nombre
# terminado en `_test`). `tests/helpers/testDb.ts` aborta la ejecución si
# apunta a cualquier otra cosa — es la salvaguarda que impide repetir el
# borrado de datos de la base de trabajo.
DATABASE_URL="postgresql://natacion:clave-publica-solo-pruebas@localhost:55432/natacion_test?schema=public"

# Confirmación explícita de que la base de arriba es DESECHABLE. Sin este
# valor exacto, la suite se niega a ejecutar cualquier borrado.
ALLOW_DESTRUCTIVE_TESTS="si-esta-base-es-desechable"

# Secreto ficticio: solo se usa para firmar/verificar tokens de acceso en
# memoria durante las pruebas. Nunca reutilizar este valor fuera de tests.
JWT_ACCESS_SECRET="test-access-secret-de-al-menos-32-caracteres-xx"
# Duracion del token de acceso. Se admite "900" (segundos), "900s", "15m", "2h" o "1d";
# se normaliza a un numero entero de segundos, entre 1 y 86400.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=7

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

PORT=3001
NODE_ENV=test

# La suite de integración hace decenas de logins seguidos desde la misma IP:
# con los límites de producción (20/min en /auth) chocaría contra el rate
# limiting y las pruebas fallarían por un motivo ajeno a lo que verifican.
RATE_LIMIT_GLOBAL_MAX=100000
RATE_LIMIT_AUTH_MAX=100000

# Cookie de sesion: en pruebas se usa el valor por omision (lax, sin Secure).
AUTH_COOKIE_SAMESITE=lax
