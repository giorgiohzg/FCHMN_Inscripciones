DATABASE_URL="postgresql://natacion:CAMBIA_ESTA_CONTRASENA@localhost:5432/natacion?schema=public"

# Unico secreto JWT del sistema: firma los tokens de acceso.
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET="reemplazar-por-un-secreto-de-al-menos-32-caracteres"
# Duracion del token de acceso. Se admite "900" (segundos), "900s", "15m", "2h" o "1d";
# se normaliza a un numero entero de segundos, entre 1 y 86400.
JWT_ACCESS_EXPIRES_IN="15m"
# Vigencia del refresh token opaco, en dias.
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Duracion absoluta de una sesion, en horas, desde su creacion. Renovar no la extiende.
SESSION_ABSOLUTE_HOURS=8

# Secreto del limitador de login (C-02): las claves de origen, cuenta y par se guardan
# como HMAC con él. Distinto de JWT_ACCESS_SECRET. Generar con: openssl rand -hex 32
# NO se rota sin un procedimiento específico: con otro valor la API no arranca.
# (Reemplaza a LOGIN_MAX_ATTEMPTS y LOGIN_LOCKOUT_MINUTES, que ya no se usan.)
AUTH_LIMITER_SECRET="reemplazar-por-otro-secreto-de-al-menos-32-caracteres"

PORT=3000

# Interfaz en la que escucha la API. Sin definir: 0.0.0.0 (todas), que es el
# comportamiento de siempre. Ponerla en 127.0.0.1 la limita a la maquina local;
# sirve para RESTRINGIR, nunca para ampliar por descuido.
# HOST=0.0.0.0

NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma. OBLIGATORIO en producción:
# sin la lista, cualquier sitio web podría llamar a la API con las credenciales
# del usuario. Vacío (solo fuera de producción) acepta cualquier origen.
CORS_ORIGINS=""

# De dónde sale la IP del cliente (ver `src/shared/ipCliente.ts`).
#   socket            -> la dirección del par TCP; se ignoran X-Forwarded-For,
#                        X-Real-IP y CF-Connecting-IP. Es lo correcto en local.
#   cf-connecting-ip  -> SOLO en Render, detrás de su borde: la cabecera
#                        CF-Connecting-IP validada, con respaldo al socket.
# Reemplaza a TRUST_PROXY_HOPS, que ya no se usa.
IP_CLIENTE_FUENTE=socket

# URL pública de la API. OBLIGATORIA en producción: es la que declara el
# documento OpenAPI como servidor.
# PUBLIC_API_URL="https://api.inscripciones.fchmn.cl"

# Documentación interactiva en /docs. Sin definir sigue al entorno: encendida
# fuera de producción, apagada en producción.
# ENABLE_SWAGGER=false

# Límites de tasa por minuto. El almacenamiento es EN MEMORIA, por instancia:
# el despliegue asume una sola instancia de la API (ver README).
RATE_LIMIT_GLOBAL_MAX=300
# Por origen: /auth/login, y aparte las operaciones de sesión (refresh, csrf, me,
# logout, change-password), para que el login no gaste el presupuesto de renovación.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SESION_MAX=60

# Semáforo de Argon2: derivaciones simultáneas, cola y espera máxima (cifras candidatas).
# ARGON2_MAX_SIMULTANEAS=4
# ARGON2_MAX_EN_COLA=16
# ARGON2_ESPERA_MAX_MS=10000

# ---------------------------------------------------------------------------
# Cookie de sesion (refresh token)
# ---------------------------------------------------------------------------
# El refresh token viaja en una cookie HttpOnly, no en el JSON de la respuesta.
#
# AUTH_COOKIE_SAMESITE:
#   lax  (por omision) — la web y la API estan bajo el MISMO sitio. Es lo
#        preferible: el navegador no manda la cookie en peticiones POST nacidas
#        en otro sitio, asi que el CSRF queda cubierto sin nada mas.
#   none — la web y la API estan en sitios DISTINTOS. Exige
#        AUTH_COOKIE_SECURE=true, exige CORS_ORIGINS con los origenes exactos, y
#        activa la comprobacion CSRF de doble envio (cabecera X-CSRF-Token).
AUTH_COOKIE_SAMESITE=lax

# Marca `Secure` (la cookie solo viaja por HTTPS). Sin definir sigue al entorno:
# activada en produccion, desactivada fuera (el desarrollo local es sobre
# http://localhost, donde una cookie Secure no se guardaria).
# AUTH_COOKIE_SECURE=true

# Administrador inicial. Solo los usa `npm run seed:admin`, que se ejecuta UNA
# vez al instalar (no forma parte de `prisma:seed` ni del arranque).
#
# AMBAS SON OBLIGATORIAS EN TODOS LOS ENTORNOS, desarrollo incluido. No hay
# valores por omision: si falta cualquiera de las dos, el comando termina con
# error en vez de crear una cuenta de administrador previsible.
#
# SEED_ADMIN_USERNAME es un NOMBRE DE USUARIO, no un correo.
# SEED_ADMIN_PASSWORD debe cumplir la misma politica que las demas contrasenas:
# 10 caracteres como minimo, con mayuscula, minuscula y numero.
#
# Elija valores propios. No los copie de ninguna plantilla ni de este archivo.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
