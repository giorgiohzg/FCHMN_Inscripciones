# Configuración de Nginx para servir la SPA.
#
# Es una PLANTILLA: la imagen oficial de Nginx procesa todo lo que esté en
# /etc/nginx/templates/*.template con `envsubst` al arrancar, y deja el
# resultado en /etc/nginx/conf.d/. Eso permite obedecer el puerto que asigna el
# entorno.
#
# `${PORT}` es imprescindible en Railway (y en Heroku, Cloud Run y similares):
# esas plataformas asignan un puerto en tiempo de ejecución y esperan que el
# proceso escuche EN ÉL. Con `listen 80` fijo, el enrutador no encuentra nada
# escuchando donde busca y el despliegue queda inaccesible sin ningún error en
# los registros del contenedor. Fuera de esas plataformas, el Dockerfile le da
# el valor por omisión 80.
#
# `NGINX_ENVSUBST_FILTER=PORT` (en el Dockerfile) limita la sustitución a esa
# variable: sin el filtro, `envsubst` también reemplazaría `$uri`, `$host` y
# `$http_upgrade` —que son variables de NGINX, no del entorno— por cadenas
# vacías, y la configuración dejaría de funcionar.
#
# El otro punto crítico es el `try_files` de más abajo: sin él, recargar el
# navegador en /competencias o entrar directo por un enlace a /clubes/:id
# devuelve 404, porque esas rutas solo existen dentro de React Router y no hay
# ningún archivo con ese nombre en disco.

# ESQUEMA ORIGINAL DE LA PETICIÓN.
#
# Detrás del borde de un proveedor, el TLS termina allí y hasta este Nginx llega
# una petición en texto claro: `$scheme` vale `http` y reenviarlo tal cual le
# diría a la API que el usuario navega sin cifrar, que es falso.
#
# El borde ya declara el esquema real en `X-Forwarded-Proto`. Este mapa lo
# conserva cuando existe y vale algo razonable, y cae a `$scheme` cuando no hay
# ningún proxy por delante (el caso de Docker Compose en la máquina local).
#
# `map` vive en el contexto `http`, no dentro de `server`: por eso está aquí
# arriba. Este archivo se incluye dentro de `http`.
map $http_x_forwarded_proto $esquema_original {
    default            $scheme;
    "~^(http|https)$"  $http_x_forwarded_proto;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # No anunciar la versión de Nginx.
    server_tokens off;

    # ------------------------------------------------------------------------
    # LA API, BAJO EL MISMO ORIGEN QUE LA WEB.
    #
    # POR QUÉ EXISTE ESTE BLOQUE. Si la web y la API viven en direcciones
    # distintas, la cookie de sesión que emite la API es una COOKIE DE TERCEROS
    # para el navegador, y hay navegadores —Safari por omisión desde 2020, y
    # cualquiera con el bloqueo activado— que sencillamente no la guardan. El
    # síntoma es cruel: el usuario inicia sesión, entra, y al recargar vuelve al
    # login, sin ningún error que lo explique.
    #
    # Sirviendo la API desde este mismo origen, en `/api`, el navegador ve UNA
    # sola dirección. No hay cookies de terceros, así que no hay nada que
    # bloquear, y además `AUTH_COOKIE_SAMESITE` puede volver a `lax`, que es más
    # seguro que `none`.
    #
    # ESTE BLOQUE VA ANTES DE `location /`, pero no por el orden en el archivo:
    # en Nginx, el prefijo más largo gana, así que `/api/` tiene prioridad sobre
    # `/` para cualquier ruta que empiece por `/api/`. Está aquí arriba para que
    # se lea primero, no porque haga falta.
    # ------------------------------------------------------------------------
    location /api/ {
        # EL DESTINO ES UNA VARIABLE, no un nombre escrito en el archivo.
        #
        # `${API_INTERNA}` lo completa `envsubst` al arrancar con el valor del
        # entorno (ver el Dockerfile), de modo que el nombre del servicio de la
        # API es configuración del despliegue y no código. Cambiarlo no exige
        # reconstruir la imagen.
        #
        # Y se pasa a `proxy_pass` a través de `$destino_api` —una variable de
        # Nginx— a propósito: con un nombre literal, Nginx resuelve el DNS UNA
        # VEZ al arrancar y conserva esa IP indefinidamente; con una variable,
        # resuelve en cada petición y sigue al backend si cambia de dirección.
        # Esa forma exige una directiva `resolver`, que escribe al arrancar
        # /docker-entrypoint.d/25-resolver.sh leyendo /etc/resolv.conf.
        set $destino_api "${API_INTERNA}";

        # Se quita el prefijo `/api` ANTES de reenviar: la API no sabe nada de
        # él y sirve en `/auth/...`, `/persons/...`, etc.
        #
        # Se hace con `rewrite ... break` y un `proxy_pass` SIN ruta, en vez de
        # con la sustitución automática de `proxy_pass http://destino/`. El
        # motivo es que esa sustitución automática no se aplica igual cuando el
        # destino es una variable; así el comportamiento es explícito y no
        # depende de ese matiz. La cadena de consulta se conserva sola.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$destino_api;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # CABECERAS REENVIADAS.
        #
        # `Host` conserva el dominio público: es lo que la API ve como destino.
        #
        # `X-Forwarded-For` AÑADE la dirección de quien nos habla a la cadena ya
        # existente (eso hace `$proxy_add_x_forwarded_for`). Detrás del borde de
        # un proveedor, la cadena que llega trae la IP real del usuario y aquí se
        # le suma la del borde. Es lo que permite que la API identifique al
        # usuario para la auditoría y el límite de tasa, y por eso
        # `TRUST_PROXY_HOPS` debe declarar DOS saltos cuando se usa este proxy:
        # el borde del proveedor y este Nginx. Ni uno más —cada salto de más es
        # una IP que el cliente puede inventar— ni uno menos.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $esquema_original;
        proxy_set_header X-Forwarded-Host  $host;

        # TAMAÑO DEL CUERPO. El límite por omisión de Nginx es 1 MB, y la API
        # acepta archivos de hasta 15 MB (importación de competencias y carga
        # masiva de personas). Sin esta línea, una importación mediana moriría
        # con un 413 de Nginx que la aplicación nunca llegaría a ver.
        #
        # Se deja un margen sobre los 15 MB porque el cuerpo multipart pesa algo
        # más que el archivo: los límites de parte y las cabeceras van dentro.
        # Quien rechaza por tamaño debe seguir siendo la API, con su mensaje.
        client_max_body_size 20m;

        # TIEMPOS. Generar un PDF o un Excel grande, o procesar una importación,
        # tarda más que los 60 s por omisión. Un corte aquí se vería como una
        # descarga que falla a medias.
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        # RUTA DE LAS COOKIES DE SESIÓN. Esta línea es imprescindible y es el
        # detalle que, omitido, reproduce exactamente el problema que el proxy
        # venía a resolver.
        #
        # La API emite sus cookies con `Path=/auth` (ver
        # `backend/src/modules/auth/session.cookie.ts`). Pero el navegador ve
        # estas rutas bajo `/api/auth/...`, que NO empieza por `/auth`, así que
        # nunca devolvería la cookie: la sesión no se mantendría. Aquí se
        # reescribe el `Path` de `Set-Cookie` al que el navegador sí usará.
        proxy_cookie_path /auth /api/auth;
    }

    # Los archivos con hash en el nombre (los que emite Vite) son inmutables:
    # cambia el nombre en cada build, así que se pueden cachear indefinidamente.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # `index.html` NO se cachea: es el que apunta a los bundles nuevos. Si el
    # navegador se queda con uno viejo, sigue pidiendo archivos que ya no
    # existen y la aplicación queda rota tras cada despliegue.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Fallback de SPA: cualquier ruta desconocida entrega index.html y deja que
    # React Router resuelva.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
