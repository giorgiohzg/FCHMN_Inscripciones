# Variables que Docker Compose sustituye dentro de docker-compose.yml.
#
# Copia este archivo como `.env` en esta misma carpeta y complétalo.
# `.env` está ignorado por Git a propósito: NUNCA debe versionarse.
#
# POSTGRES_PASSWORD debe ser IDÉNTICA a la contraseña que aparece dentro de
# DATABASE_URL en `backend/.env`. Para comprobarlo, desde la carpeta `backend`:
#
#     npm run verificar:credencial
#
# Usa solo letras, números y los signos  . _ ~ -  : así la contraseña no
# necesita codificación especial dentro de la URL de conexión.
#
# Si esta variable falta o queda vacía, `docker compose` se detiene con el
# mensaje «define POSTGRES_PASSWORD en el .env de la raiz» en lugar de arrancar
# con una contraseña vacía.
POSTGRES_PASSWORD=
